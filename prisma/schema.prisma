generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// A learner. `id` is the portal account's `sub` (a Supabase user id, or "mock-user" in
// local development), so there is no local sign-in: the page gate and every API route
// verify the portal session and upsert this row. XP, streaks, gems, quests and
// achievements live in the school ledger on the portal, not here.
model User {
  id          String   @id
  displayName String?
  createdAt   DateTime @default(now())

  // Which course the learner is currently on. Null for brand-new users, who
  // are sent to the first-run picker before reaching the app.
  activeCourseId String?

  // Revision of the summary last published to the portal launcher. Incremented in the
  // same transaction that reads the summarised snapshot, so a delayed older summary
  // loses to the portal's `rev` guard (work order criterion 17).
  summaryRev Int @default(0)

  lessonProgress LessonProgress[]
  wordReviews    WordReview[]
  submissions    Submission[]
}

// One finished quiz (a lesson or a review session), keyed by an id the browser creates
// once per quiz and keeps across retries and the sign-in round trip. A repeat of the same
// id is recognised inside the completion transaction and changes nothing: no SRS writes,
// no award; it gets back the outcome recorded for the first one (Codex WW-P5-R3-001).
model Submission {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String
  createdAt DateTime @default(now())
  // JSON of the award outcome once the portal answered; null until then.
  award     String?

  @@id([userId, id])
}

// A learnable language course. The app ships Spanish (grandfathered content
// IDs) and Classical Latin. Progress (LessonProgress / WordReview) is per
// course by virtue of course-scoped content IDs + route gating.
model Course {
  id                 String  @id
  code               String  @unique // "es", "la" — stable lookup key used by the seed and active-course APIs
  name               String // display name, e.g. "Spanish"
  promptLanguageName String // fills "Type the {X} for …" prompts, e.g. "Spanish" / "Latin"
  emblem             String // short emblem string for the swap control (flag / SPQR)
  order              Int
  correctLabel       String // per-answer affirmation, e.g. "¡Correcto!" / "Rēctē!"
  celebrateLabel     String // end-of-session celebration, e.g. "¡Muy bien!" / "Euge!"
  isAvailable        Boolean @default(true) // dev-only/fixture courses set this false; hidden from the picker/switch in production

  sections Section[]
  words    Word[]
}

model Section {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level       Int     @default(1) // 1/2/3 — persisted so /api/units and layout can work structurally
  fillBlank   Boolean @default(false) // Level-3 typed-answer sections
  title       String
  description String
  order       Int
  units       Unit[]
}

model Unit {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id         String      @id @default(cuid())
  unitId     String
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  challenges Challenge[]
  progress   LessonProgress[]
}

model Challenge {
  id            String @id @default(cuid())
  lessonId      String
  lesson        Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          String // MATCH | TRANSLATE | MULTIPLE_CHOICE
  order         Int
  prompt        String
  correctAnswer String
  meta          String // JSON: type-specific payload (choices / word bank / pairs / wordIds)
}

model Word {
  id          String       @id @default(cuid())
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  term        String // term in the course's target language
  translation String // English
  reviews     WordReview[]

  @@unique([courseId, term])
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model WordReview {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  interval   Int      @default(0) // days; 0 = relearning (due in hours)
  easeFactor Float    @default(2.5)
  dueAt      DateTime
  lapses     Int      @default(0)
  lastResult String? // correct | wrong

  @@unique([userId, wordId])
}
