generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String   @id @default(cuid())
  email            String?  @unique
  passwordHash     String?
  googleId         String?  @unique
  displayName      String?
  isGuest          Boolean  @default(false)
  createdAt        DateTime @default(now())
  hearts           Int      @default(5)
  xp               Int      @default(0)
  streakCount      Int      @default(0)
  lastActiveDate   String? // YYYY-MM-DD of last lesson/review completion
  heartsUpdatedAt  DateTime @default(now())
  gems             Int      @default(0)
  streakFreezes    Int      @default(0)
  lessonsCompleted Int      @default(0)
  perfectLessons   Int      @default(0)
  reviewsCompleted Int      @default(0)

  lessonProgress LessonProgress[]
  wordReviews    WordReview[]
  questProgress  QuestProgress[]
  achievements   Achievement[]
  sessions       Session[]
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model QuestProgress {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD the quest belongs to
  questKey  String
  progress  Int     @default(0)
  completed Boolean @default(false)

  @@unique([userId, date, questKey])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model Section {
  id          String @id @default(cuid())
  title       String
  description String
  order       Int
  units       Unit[]
}

model Unit {
  id          String   @id @default(cuid())
  sectionId   String
  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String
  order       Int
  lessons     Lesson[]
}

model Lesson {
  id         String      @id @default(cuid())
  unitId     String
  unit       Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  order      Int
  challenges Challenge[]
  progress   LessonProgress[]
}

model Challenge {
  id            String @id @default(cuid())
  lessonId      String
  lesson        Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          String // MATCH | TRANSLATE | MULTIPLE_CHOICE
  order         Int
  prompt        String
  correctAnswer String
  meta          String // JSON: type-specific payload (choices / word bank / pairs / wordIds)
}

model Word {
  id          String       @id @default(cuid())
  term        String       @unique // Spanish
  translation String // English
  reviews     WordReview[]
}

model LessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([userId, lessonId])
}

model WordReview {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId     String
  word       Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  interval   Int      @default(0) // days; 0 = relearning (due in hours)
  easeFactor Float    @default(2.5)
  dueAt      DateTime
  lapses     Int      @default(0)
  lastResult String? // correct | wrong

  @@unique([userId, wordId])
}
