# Word Wave environment. Copy to `.env` for local development; never commit real values.
# Each variable is also listed in README "Deploy" (class standard rule 2.5).

# Portal Supabase project URL: the page gate and API routes verify the session against
# its JWKS, and the server credits the school ledger through its RPCs. Required everywhere.
NEXT_PUBLIC_SUPABASE_URL=

# The portal's public anon key, sent as `apikey` on the server's award/unlock/
# save_progress calls (with the learner's own token as the bearer). Production only;
# not needed with the dev mock below.
SUPABASE_ANON_KEY=

# Runtime database. Production: the Supavisor transaction pooler (port 6543) as role
# `wordwave_app.<project-ref>` (docs/db/wordwave-role.sql). Local: the URL `npm run db:dev`
# prints (postgres://postgres:postgres@localhost:54329/wordwave). Tables live in schema `wordwave` (set by the app and prisma.config.ts).
DATABASE_URL=

# Migrations and the seed, run by hand against production: the session pooler (port 5432),
# same role. Never set on Vercel. Unset locally (DATABASE_URL is used).
MIGRATE_DATABASE_URL=

# Local development only: `mock` selects the mock kit and the mock session and portal.
# Never set in any hosted environment.
NEXT_PUBLIC_TS_KIT=
